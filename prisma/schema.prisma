generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model GuildConfig {
  id               String   @id @default(cuid()) @db.VarChar(191)
  guildId          String   @unique @db.VarChar(32)
  ticketCategoryId String?  @db.VarChar(32)
  enabled          Boolean  @default(true)
  maxLearnedItems  Int      @default(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  learnedAnswers   LearnedAnswer[]
  ticketChannels   TicketChannel[]
}

model LearnedAnswer {
  id        String      @id @default(cuid()) @db.VarChar(191)
  guildId   String      @db.VarChar(32)
  question  String      @db.Text
  answer    String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model TicketChannel {
  id        String      @id @default(cuid()) @db.VarChar(191)
  guildId   String      @db.VarChar(32)
  channelId String      @unique @db.VarChar(32)
  userId    String      @db.VarChar(32)
  category  String      @default("general") @db.VarChar(32)
  name      String      @db.VarChar(100)
  claimedBy String?     @db.VarChar(32)
  priority  String      @default("medium") @db.VarChar(16)
  locked    Boolean     @default(false)
  escalated Boolean     @default(false)
  closed    Boolean     @default(false)
  openedAt  DateTime    @default(now())
  closedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, userId, closed])
}
