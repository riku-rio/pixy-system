{
  "name": "pixy-system",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "db:up": "docker compose --env-file .env.docker up -d mysql",
    "db:down": "docker compose --env-file .env.docker down",
    "db:clear": "node scripts/clear-database.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "mariadb": "^3.4.5"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
