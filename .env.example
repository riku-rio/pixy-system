# Runtime
NODE_ENV=development
BOT_INSTANCE_NAME=pixy-system-testing
PORT=3000

# Discord application and server
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
PREFIX=^
OWNER_ID=

# Server-specific roles and channels
ADMIN_ROLE_ID=
TICKET_CATEGORY_ID=
TICKET_LOG_CHANNEL_ID=
TICKET_NOTIFICATIONS_CHANNEL_ID=
BUG_FALLBACK_CHANNEL_ID=
SUGGESTION_CHANNEL_ID=

# Database - use a separate database for every bot instance
DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@127.0.0.1:3308/<DATABASE_NAME>"
