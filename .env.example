NODE_ENV=production
BOT_INSTANCE_NAME=pixy-system

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
PREFIX=!
OWNER_ID=

# Discord resource IDs
ADMIN_ROLE_ID=
TICKET_CATEGORY_ID=
TICKET_LOG_CHANNEL_ID=
TICKET_NOTIFICATIONS_CHANNEL_ID=
BUG_FALLBACK_CHANNEL_ID=
SUGGESTION_CHANNEL_ID=

# Database
# Production: one MySQL 8 instance on the VPS, with a dedicated database and user
# for this application. Keep MySQL bound to 127.0.0.1 and use a different database
# and user for every application sharing the instance.
DATABASE_URL="mysql://pixy_system_app:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@127.0.0.1:3306/pixy_system?connection_limit=5&connect_timeout=5&max_idle_connection_lifetime=300"
